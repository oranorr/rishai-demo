# Скопируй в .env.copy-user в корне репо (файл в .gitignore)
#
# ── Prod Directus (чтение) ──────────────────────────────────────────
PROD_DIRECTUS_URL=https://rishai-directus-app-54tcs.ondigitalocean.app
PROD_DIRECTUS_TOKEN=

# Алиасы (тоже работают): PROD_DIRECTUS_API_URL

# ── Staging Directus (запись) ───────────────────────────────────────
STAGING_DIRECTUS_URL=http://your-staging-host:8855
STAGING_DIRECTUS_TOKEN=

# Алиасы (тоже работают): STAGING_DIRECTUS_API_URL

# ── Коллекции Directus (дефолты: user, day, weekPlans) ───────────────
# USERS_COLLECTION=user
# DAYS_COLLECTION=day
# WEEK_PLANS_COLLECTION=weekPlans
