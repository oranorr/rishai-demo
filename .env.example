# Скопируйте в .env и заполните своими ключами.
# Для демо-репозитория используйте только placeholder-значения.

# OpenAI
OPEN_AI_API_KEY=your_openai_api_key_here

# WHOOP
WHOOP_CLIENT_ID=your_whoop_client_id_here
WHOOP_CLIENT_SECRET=your_whoop_client_secret_here

# GPT Assistant
GPT_ASSISTANT_ID=your_gpt_assistant_id_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Adapty (In-App Purchases)
ADAPTY_SDK_KEY=your_adapty_sdk_key_here

# Backend auth header
AUTH_HEADER_KEY=your_auth_header_key_here
